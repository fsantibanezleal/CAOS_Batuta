{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_id": "C23",
  "contract_version": "1.0",
  "title": "Inventory",
  "description": "The dimensioned design of a system (ADR-0080 section 1): repositories, components with their modules, size, exact stack and availability declarations, evaluations (summaries of C25), contracts, and the parallel units. A component that can be absent declares availability (the C26 state declarations).",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "1.0"
    },
    "system": {
      "type": "string",
      "minLength": 1
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "visibility": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "role",
          "visibility"
        ],
        "additionalProperties": true
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "concern": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "ring": {
            "type": "string",
            "enum": [
              "adopt",
              "trial",
              "assess",
              "caution"
            ]
          },
          "adr": {
            "type": "string",
            "pattern": "^ADR-\\d{4}$"
          }
        },
        "required": [
          "id",
          "decision",
          "ring",
          "adr"
        ],
        "additionalProperties": true
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "json-schema",
              "openapi"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^[^/\\\\:][^\\\\:]*$",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
          },
          "frozen": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "kind",
          "path",
          "version",
          "frozen"
        ],
        "additionalProperties": true
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "components": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "consumes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "provides": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "wave": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "agent_role": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "components",
          "consumes",
          "provides",
          "wave",
          "agent_role"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "contract_version",
    "system",
    "repos",
    "components",
    "evaluations",
    "contracts",
    "units"
  ],
  "additionalProperties": true,
  "$defs": {
    "stack_entry": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9][A-Za-z0-9._+-]*$",
          "description": "Exact version, never a range."
        },
        "ring": {
          "type": "string",
          "enum": [
            "adopt",
            "trial",
            "assess",
            "caution"
          ]
        }
      },
      "required": [
        "tool",
        "version",
        "ring"
      ],
      "additionalProperties": true
    },
    "availability_entry": {
      "type": "object",
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "adapter_returns": {
          "type": "string",
          "minLength": 1,
          "description": "What the adapter or provider returns in this state."
        },
        "response_block": {
          "type": "string",
          "minLength": 1,
          "description": "The runtime block the API response or artifact carries in this state."
        },
        "ui_shows": {
          "type": "string",
          "minLength": 1,
          "description": "What the page shows in this state."
        },
        "test": {
          "type": "string",
          "minLength": 1,
          "description": "The id of the test that proves this state."
        }
      },
      "required": [
        "state",
        "adapter_returns",
        "response_block",
        "ui_shows",
        "test"
      ],
      "additionalProperties": true
    },
    "component": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "frontend",
            "api",
            "pipeline-stage",
            "engine",
            "model",
            "connector",
            "dataset",
            "job",
            "library",
            "docs",
            "infra"
          ]
        },
        "responsibility": {
          "type": "string",
          "minLength": 1
        },
        "provides": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "consumes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "exposes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "path",
              "exposes"
            ],
            "additionalProperties": true
          }
        },
        "size": {
          "type": "object",
          "properties": {
            "class": {
              "type": "string",
              "enum": [
                "S",
                "M",
                "L",
                "XL"
              ]
            },
            "functions": {
              "type": "integer",
              "minimum": 0
            },
            "tests": {
              "type": "integer",
              "minimum": 0
            },
            "basis": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "class",
            "functions",
            "tests",
            "basis"
          ],
          "additionalProperties": true
        },
        "stack": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stack_entry"
          }
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "gates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "can_be_absent": {
          "type": "boolean"
        },
        "availability": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/availability_entry"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "responsibility",
        "provides",
        "consumes",
        "modules",
        "size",
        "stack",
        "unit",
        "gates"
      ],
      "additionalProperties": true
    },
    "state": {
      "type": "string",
      "enum": [
        "available",
        "partial",
        "stale",
        "synthetic",
        "training",
        "missing"
      ],
      "description": "available, partial, stale, synthetic, training or missing (case-sensitive)."
    }
  }
}
