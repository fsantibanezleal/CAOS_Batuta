{
  "contract_id": "C09",
  "contract_version": "1.0",
  "front_matter": "required",
  "sections": [
    "Definition of done restated",
    "Commands and output",
    "Findings",
    "Waivers requested"
  ],
  "tables": [
    {
      "name": "Findings",
      "headers": [
        "Id",
        "Severity",
        "Claim",
        "Reproduction",
        "Status"
      ],
      "row_def": "finding_row",
      "min_rows": 0
    }
  ],
  "rules": [
    {
      "type": "forbid_rows",
      "when": {
        "verdict": [
          "PASS"
        ]
      },
      "table": "Findings",
      "match": {
        "Severity": [
          "critical",
          "major"
        ],
        "Status": [
          "open"
        ]
      },
      "message": "PASS requires no open critical or major finding"
    },
    {
      "type": "require_text_if_rows",
      "when": {
        "verdict": [
          "PASS-WITH-FIXES"
        ]
      },
      "table": "Findings",
      "match": {
        "Status": [
          "fixed"
        ]
      },
      "pattern": "Re-check",
      "message": "PASS-WITH-FIXES requires a Re-check line for the fixed findings"
    }
  ]
}
