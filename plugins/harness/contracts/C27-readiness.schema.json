{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_id": "C27",
  "contract_version": "1.0",
  "title": "Readiness",
  "description": "What is real in a build, per catalog row (contracts) and per component (components): real or stub, its availability state, what served it, why it is not available, and the commit it was computed from. Compatible with the readiness document of the product template. At least one of contracts or components is non-empty.",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "1.0"
    },
    "schema": {
      "type": "string"
    },
    "product_version": {
      "type": "string"
    },
    "catalog_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "as_of_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "contracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "required": [],
  "additionalProperties": true,
  "$defs": {
    "entry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "real",
            "stub",
            "active"
          ],
          "description": "real once the real producer serves it; stub while a stub, simulator, fixture or baseline does; active is the product template's word for stub."
        },
        "state": {
          "type": "string",
          "enum": [
            "available",
            "partial",
            "stale",
            "synthetic",
            "training",
            "missing",
            "provider"
          ],
          "description": "An availability state. provider is accepted for the product template's readiness document and reads as synthetic."
        },
        "provenance": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "real",
            "stub",
            "simulator",
            "fixture",
            "baseline",
            null
          ]
        },
        "reason": {
          "type": [
            "string",
            "object",
            "null"
          ],
          "description": "A reason: a string, or an object with an 'en' string (bilingual products add 'es'); null only when available."
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "as_of_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        }
      },
      "required": [
        "id",
        "status",
        "state",
        "provenance",
        "reason"
      ],
      "additionalProperties": true
    }
  }
}
