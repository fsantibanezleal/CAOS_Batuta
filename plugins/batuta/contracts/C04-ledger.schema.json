{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_id": "C04",
  "contract_version": "1.0",
  "title": "Delegation ledger line",
  "description": "One object per line of .batuta/delegation/ledger.jsonl. Lines starting with # are comments.",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "lookup",
        "run",
        "implement",
        "test",
        "docs",
        "review",
        "adversary",
        "research"
      ]
    },
    "brief": {
      "type": "string",
      "minLength": 1
    },
    "report": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "drafted",
        "launched",
        "complete",
        "incomplete",
        "defective",
        "accepted",
        "superseded",
        "lost"
      ]
    },
    "accepted_by": {
      "type": "string",
      "minLength": 1
    },
    "accepted_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "superseded_by": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "contract_version",
    "id",
    "agent",
    "model",
    "kind",
    "brief",
    "report",
    "status"
  ],
  "additionalProperties": false
}
