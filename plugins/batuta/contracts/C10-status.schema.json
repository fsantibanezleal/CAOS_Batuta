{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_id": "C10",
  "contract_version": "1.0",
  "title": "Feature status",
  "description": "Status front matter of a feature: phase, per-gate state, waivers, blocked.",
  "type": "object",
  "properties": {
    "feature": {
      "type": "string",
      "pattern": "^\\d{3}-[a-z0-9-]+$"
    },
    "phase": {
      "type": "string",
      "enum": [
        "L0-understand",
        "L1-size",
        "L2-decide",
        "L3-contracts",
        "L4-boundaries",
        "L5-freeze",
        "L6-skeleton",
        "L7-build",
        "L8-integrate",
        "L9-promote",
        "L10-lessons",
        "done"
      ]
    },
    "gates": {
      "type": "object",
      "properties": {
        "L0-understand": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "failed",
            "waived"
          ]
        },
        "L1-size": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "failed",
            "waived"
          ]
        },
        "L2-decide": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "failed",
            "waived"
          ]
        },
        "L3-contracts": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "failed",
            "waived"
          ]
        },
        "L4-boundaries": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "failed",
            "waived"
          ]
        },
        "L5-freeze": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "failed",
            "waived"
          ]
        },
        "L6-skeleton": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "failed",
            "waived"
          ]
        },
        "L7-build": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "failed",
            "waived"
          ]
        },
        "L8-integrate": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "failed",
            "waived"
          ]
        },
        "L9-promote": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "failed",
            "waived"
          ]
        },
        "L10-lessons": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "failed",
            "waived"
          ]
        }
      },
      "additionalProperties": false
    },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "gate": {
            "type": "string",
            "enum": [
              "L0-understand",
              "L1-size",
              "L2-decide",
              "L3-contracts",
              "L4-boundaries",
              "L5-freeze",
              "L6-skeleton",
              "L7-build",
              "L8-integrate",
              "L9-promote",
              "L10-lessons"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "by": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "gate",
          "reason",
          "by",
          "date"
        ],
        "additionalProperties": true
      }
    },
    "blocked": {
      "type": "boolean"
    },
    "blocked_reason": {
      "type": "string"
    }
  },
  "required": [
    "feature",
    "phase",
    "gates"
  ],
  "additionalProperties": true
}
