{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_id": "C33",
  "contract_version": "1.0",
  "title": "Test change requests",
  "description": "specs/<feature>/test-change-requests.md: the table of requests to change a locked test (TDD-4). Columns Id, Date, Test path, Requirement, Reason, Proposed change, Status and Decided by. Id is the id a C07 entry names in `change_request` and the value of the commit trailer `Test-Change-Approved` (C32); it matches the C07 pattern and is unique. Status is open, approved or rejected; an approved or rejected request names who decided it. Only an approved request authorises superseding a lock.",
  "type": "object",
  "$defs": {
    "request_row": {
      "type": "object",
      "properties": {
        "Id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "Date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "format": "date"
        },
        "Test path": {
          "type": "string",
          "pattern": "^(?![\\s\\S]*(^|/)\\.\\.?(/|$))(?![\\s\\S]*//)[^/\\\\:\\x00-\\x1f][^\\\\:\\x00-\\x1f]*$"
        },
        "Requirement": {
          "type": "string",
          "pattern": "^REQ-[A-Z0-9]+-\\d{3}$"
        },
        "Reason": {
          "type": "string",
          "minLength": 1
        },
        "Proposed change": {
          "type": "string",
          "minLength": 1
        },
        "Status": {
          "type": "string",
          "enum": [
            "open",
            "approved",
            "rejected"
          ]
        },
        "Decided by": {
          "type": "string"
        }
      },
      "required": [
        "Id",
        "Date",
        "Test path",
        "Requirement",
        "Reason",
        "Proposed change",
        "Status",
        "Decided by"
      ],
      "additionalProperties": true
    }
  }
}
