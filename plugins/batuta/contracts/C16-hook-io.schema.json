{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_id": "C16",
  "contract_version": "1.1",
  "title": "Hook input and output",
  "description": "Input subset read per hook event and the outputs Batuta emits (1.1 adds the UserPromptSubmit output, as the Claude Code hooks reference defines it). Fixtures are payloads shaped like Claude Code hook payloads with secrets removed; no contract_version because these are not batuta-owned files.",
  "type": "object",
  "$defs": {
    "input_SessionStart": {
      "type": "object",
      "properties": {
        "hook_event_name": {
          "const": "SessionStart"
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "hook_event_name",
        "source"
      ],
      "additionalProperties": true
    },
    "input_PreToolUse": {
      "type": "object",
      "properties": {
        "hook_event_name": {
          "const": "PreToolUse"
        },
        "tool_name": {
          "type": "string",
          "minLength": 1
        },
        "tool_input": {
          "type": "object"
        }
      },
      "required": [
        "hook_event_name",
        "tool_name",
        "tool_input"
      ],
      "additionalProperties": true
    },
    "input_SubagentStop": {
      "type": "object",
      "properties": {
        "hook_event_name": {
          "const": "SubagentStop"
        },
        "agent_type": {
          "type": "string",
          "minLength": 1
        },
        "last_assistant_message": {
          "type": "string"
        },
        "stop_hook_active": {
          "type": "boolean"
        },
        "agent_transcript_path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "hook_event_name",
        "agent_type",
        "last_assistant_message"
      ],
      "additionalProperties": true
    },
    "input_UserPromptSubmit": {
      "type": "object",
      "properties": {
        "hook_event_name": {
          "const": "UserPromptSubmit"
        },
        "prompt": {
          "type": "string"
        }
      },
      "required": [
        "hook_event_name",
        "prompt"
      ],
      "additionalProperties": true
    },
    "input_Stop": {
      "type": "object",
      "properties": {
        "hook_event_name": {
          "const": "Stop"
        },
        "stop_hook_active": {
          "type": "boolean"
        }
      },
      "required": [
        "hook_event_name"
      ],
      "additionalProperties": true
    },
    "output_block": {
      "type": "object",
      "properties": {
        "decision": {
          "const": "block"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "decision",
        "reason"
      ],
      "additionalProperties": true
    },
    "output_pretooluse": {
      "type": "object",
      "properties": {
        "hookSpecificOutput": {
          "type": "object",
          "properties": {
            "hookEventName": {
              "const": "PreToolUse"
            },
            "permissionDecision": {
              "type": "string",
              "enum": [
                "allow",
                "deny",
                "ask"
              ]
            },
            "permissionDecisionReason": {
              "type": "string"
            }
          },
          "required": [
            "hookEventName",
            "permissionDecision",
            "permissionDecisionReason"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "hookSpecificOutput"
      ],
      "additionalProperties": true
    },
    "output_userpromptsubmit": {
      "type": "object",
      "properties": {
        "continue": {
          "type": "boolean"
        },
        "stopReason": {
          "type": "string"
        },
        "suppressOutput": {
          "type": "boolean"
        },
        "systemMessage": {
          "type": "string",
          "description": "Message shown to the human."
        },
        "terminalSequence": {
          "type": "string"
        },
        "decision": {
          "const": "block",
          "description": "block stops the prompt; it comes with a non-blank reason (semantic check)."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Shown to the human when decision is block; not added to context."
        },
        "hookSpecificOutput": {
          "type": "object",
          "properties": {
            "hookEventName": {
              "const": "UserPromptSubmit"
            },
            "additionalContext": {
              "type": "string",
              "maxLength": 10000,
              "description": "Added to the model's context alongside the submitted prompt."
            },
            "sessionTitle": {
              "type": "string"
            },
            "suppressOriginalPrompt": {
              "type": "boolean"
            }
          },
          "required": [
            "hookEventName"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "description": "Output of a UserPromptSubmit hook (1.1): the universal fields, the top-level block decision and hookSpecificOutput, closed. Fields as listed in the Claude Code hooks reference, section UserPromptSubmit decision control."
    },
    "output_sessionstart": {
      "type": "object",
      "properties": {
        "hookSpecificOutput": {
          "type": "object",
          "properties": {
            "hookEventName": {
              "const": "SessionStart"
            },
            "additionalContext": {
              "type": "string",
              "maxLength": 10000
            }
          },
          "required": [
            "hookEventName",
            "additionalContext"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "hookSpecificOutput"
      ],
      "additionalProperties": true
    }
  }
}
