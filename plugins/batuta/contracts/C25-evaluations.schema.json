{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_id": "C25",
  "contract_version": "1.0",
  "title": "Technology decision",
  "description": "A row of the sizing's Technology matrix as a file (docs/design/tech/<tool>.json): tool, exact version (never a range), primary source URL and verified date. The optional `evaluation` holds the candidates considered; a risky candidate carries a spike and a risky chosen candidate needs a spike that passed. `contract lint --root` checks every file equals a Technology matrix row of the sizing.",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "1.0"
    },
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(\\.\\d+){0,2}(\\.?(a|b|rc|post|dev)\\d+)*(-[A-Za-z][0-9A-Za-z]*(\\.[0-9A-Za-z]+)*)?(\\+[0-9A-Za-z.-]+)?$",
      "description": "An exact version: never a range, a wildcard or a bare major."
    },
    "primary_source_url": {
      "type": "string",
      "pattern": "^https?://\\S+$"
    },
    "verified_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "ring": {
      "type": "string",
      "enum": [
        "adopt",
        "trial",
        "assess",
        "caution"
      ]
    },
    "adr": {
      "type": "string",
      "pattern": "^ADR-\\d{4}$"
    },
    "evaluation": {
      "$ref": "#/$defs/evaluation"
    }
  },
  "required": [
    "contract_version",
    "tool",
    "version",
    "primary_source_url",
    "verified_date"
  ],
  "additionalProperties": true,
  "$defs": {
    "evaluation": {
      "type": "object",
      "properties": {
        "concern": {
          "type": "string",
          "minLength": 1
        },
        "chosen": {
          "type": "string",
          "minLength": 1,
          "description": "The name of the chosen candidate; it must equal the row's tool."
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/candidate"
          }
        }
      },
      "required": [
        "concern",
        "chosen",
        "candidates"
      ],
      "additionalProperties": true
    },
    "candidate": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+(\\.\\d+){0,2}(\\.?(a|b|rc|post|dev)\\d+)*(-[A-Za-z][0-9A-Za-z]*(\\.[0-9A-Za-z]+)*)?(\\+[0-9A-Za-z.-]+)?$",
          "description": "An exact version, never a range."
        },
        "source_url": {
          "type": "string",
          "pattern": "^https?://\\S+$"
        },
        "verified": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "maturity": {
          "type": "object",
          "properties": {
            "last_release": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "maintainers": {
              "type": "integer",
              "minimum": 0
            },
            "stars": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "last_release",
            "maintainers",
            "stars"
          ],
          "additionalProperties": true
        },
        "maintenance": {
          "type": "string",
          "minLength": 1,
          "description": "Release cadence, maintainers, responsiveness."
        },
        "size": {
          "type": "string",
          "minLength": 1,
          "description": "Footprint: install size, lines, or dependency count."
        },
        "fit": {
          "type": "string",
          "minLength": 1
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risky": {
          "type": "boolean"
        },
        "spike": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1
            },
            "result": {
              "type": "string",
              "enum": [
                "pass",
                "fail",
                "not-run"
              ]
            },
            "evidence": {
              "type": "string"
            }
          },
          "required": [
            "command",
            "result",
            "evidence"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "name",
        "version",
        "source_url",
        "verified",
        "license",
        "maturity",
        "maintenance",
        "size",
        "fit",
        "risks"
      ],
      "additionalProperties": true
    }
  }
}
