{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_id": "C25",
  "contract_version": "1.0",
  "title": "Evaluation",
  "description": "One evaluation per concern: candidates judged on fit, license, maturity, maintenance, size and exact version, a decision, its ring (adopt, trial, assess, caution) and the ADR that records it. A candidate marked risky carries a spike.",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "concern": {
      "type": "string",
      "minLength": 1
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      },
      "minItems": 1
    },
    "decision": {
      "type": "string",
      "minLength": 1
    },
    "ring": {
      "type": "string",
      "enum": [
        "adopt",
        "trial",
        "assess",
        "caution"
      ]
    },
    "adr": {
      "type": "string",
      "pattern": "^ADR-\\d{4}$"
    }
  },
  "required": [
    "contract_version",
    "id",
    "concern",
    "candidates",
    "decision",
    "ring",
    "adr"
  ],
  "additionalProperties": true,
  "$defs": {
    "candidate": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9][A-Za-z0-9._+-]*$",
          "description": "Exact pinned version, never a range."
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "maturity": {
          "type": "object",
          "properties": {
            "last_release": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "maintainers": {
              "type": "integer",
              "minimum": 0
            },
            "stars": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "last_release",
            "maintainers",
            "stars"
          ],
          "additionalProperties": true
        },
        "maintenance": {
          "type": "string",
          "minLength": 1,
          "description": "How the project is maintained: release cadence, maintainers, responsiveness."
        },
        "size": {
          "type": "string",
          "minLength": 1,
          "description": "Footprint: install size, lines, or dependency count."
        },
        "fit": {
          "type": "string",
          "minLength": 1
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risky": {
          "type": "boolean"
        },
        "spike": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1
            },
            "result": {
              "type": "string",
              "enum": [
                "pass",
                "fail",
                "not-run"
              ]
            },
            "evidence": {
              "type": "string"
            }
          },
          "required": [
            "command",
            "result",
            "evidence"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "name",
        "version",
        "license",
        "maturity",
        "maintenance",
        "size",
        "fit",
        "risks",
        "spike"
      ],
      "additionalProperties": true
    }
  }
}
