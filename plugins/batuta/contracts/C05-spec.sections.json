{
  "contract_id": "C05",
  "contract_version": "1.0",
  "front_matter": "required",
  "sections": [
    "Problem",
    "Scope and out of scope",
    "Requirements",
    "Interfaces",
    "Edge cases",
    "Open questions"
  ],
  "tables": [
    {
      "name": "Requirements",
      "headers": [
        "Id",
        "Kind",
        "EARS text",
        "Gate",
        "Verification",
        "Status"
      ],
      "row_def": "requirement_row",
      "min_rows": 0
    }
  ],
  "rules": [
    {
      "type": "unique_column",
      "table": "Requirements",
      "column": "Id"
    },
    {
      "type": "forbid_text",
      "when": {
        "status": [
          "Review",
          "Frozen"
        ]
      },
      "pattern": "\\[NEEDS CLARIFICATION\\]"
    },
    {
      "type": "min_rows",
      "when": {
        "status": [
          "Frozen"
        ]
      },
      "table": "Requirements",
      "min": 1,
      "message": "a Frozen spec has at least one requirement row"
    },
    {
      "type": "nonempty_sections",
      "when": {
        "status": [
          "Review",
          "Frozen"
        ]
      },
      "sections": [
        "Interfaces"
      ]
    },
    {
      "type": "item_rule",
      "when": {
        "status": [
          "Review",
          "Frozen"
        ]
      },
      "section": "Interfaces",
      "item_pattern": ".",
      "require": "^[a-z0-9][a-z0-9-]*(\\s|:|$)",
      "message": "an Interfaces item starts with a catalog contract id (or the word none)"
    }
  ]
}
