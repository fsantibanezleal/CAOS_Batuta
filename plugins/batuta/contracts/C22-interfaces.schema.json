{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_id": "C22",
  "contract_version": "1.0",
  "title": "Interface table",
  "description": "The Interfaces table of a spec: each interface linked to its contract file; every named interface has a row.",
  "type": "object",
  "properties": {
    "Interface": {
      "type": "string",
      "minLength": 1
    },
    "Contract file": {
      "type": "string",
      "pattern": "^[^/\\\\:][^\\\\:]*$",
      "minLength": 1
    },
    "Producer": {
      "type": "string",
      "minLength": 1
    },
    "Consumers": {
      "type": "string",
      "minLength": 1
    },
    "Version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    }
  },
  "required": [
    "Interface",
    "Contract file",
    "Producer",
    "Consumers",
    "Version"
  ],
  "additionalProperties": true
}
