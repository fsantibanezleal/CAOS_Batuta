{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_id": "C12",
  "contract_version": "1.0",
  "title": "Knowledge manifest",
  "description": "Index of knowledge units (rules, procedures, decisions, memories, references) with load policy and a context budget.",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "1.0"
    },
    "budget": {
      "type": "object",
      "properties": {
        "core_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "index_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "core_bytes",
        "index_bytes"
      ],
      "additionalProperties": true
    },
    "units": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unit"
      }
    }
  },
  "required": [
    "contract_version",
    "budget",
    "units"
  ],
  "additionalProperties": true,
  "$defs": {
    "unit": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "rule",
            "procedure",
            "decision",
            "memory",
            "reference"
          ]
        },
        "file": {
          "type": "string",
          "pattern": "^[^/\\\\:][^\\\\:]*$",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "load": {
          "type": "string",
          "enum": [
            "always",
            "path",
            "trigger",
            "manual"
          ]
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "triggers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "related": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "enforced_by": {
          "type": "string"
        },
        "updated": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "id",
        "title",
        "kind",
        "file",
        "summary",
        "load"
      ],
      "additionalProperties": true
    }
  }
}
