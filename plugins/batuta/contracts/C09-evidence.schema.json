{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_id": "C09",
  "contract_version": "1.0",
  "title": "Gate evidence",
  "description": "Evidence file of one gate: verdict, commands and output, findings table, waivers.",
  "type": "object",
  "properties": {
    "gate": {
      "type": "string",
      "enum": [
        "L0-understand",
        "L1-size",
        "L2-decide",
        "L3-contracts",
        "L4-boundaries",
        "L5-freeze",
        "L6-skeleton",
        "L7-build",
        "L8-integrate",
        "L9-promote",
        "L10-lessons"
      ],
      "description": "A lifecycle gate: L0-understand to L10-lessons (the retired P-names are refused)."
    },
    "feature": {
      "type": "string",
      "pattern": "^(\\d{3}-[a-z0-9-]+|[a-z0-9][a-z0-9-]*)$",
      "description": "A spec id (NNN-slug) or a product slug (a feature of the product itself, for example batuta)."
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "PASS-WITH-FIXES"
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "adversary",
        "reviewer",
        "script"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "commit": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "required": [
    "gate",
    "feature",
    "verdict",
    "role",
    "model",
    "commit",
    "date"
  ],
  "additionalProperties": true,
  "$defs": {
    "finding_row": {
      "type": "object",
      "properties": {
        "Id": {
          "type": "string",
          "minLength": 1
        },
        "Severity": {
          "type": "string",
          "enum": [
            "critical",
            "major",
            "minor"
          ]
        },
        "Claim": {
          "type": "string",
          "minLength": 1
        },
        "Reproduction": {
          "type": "string",
          "minLength": 1
        },
        "Status": {
          "type": "string",
          "enum": [
            "open",
            "fixed",
            "dropped-no-repro"
          ]
        }
      },
      "required": [
        "Id",
        "Severity",
        "Claim",
        "Reproduction",
        "Status"
      ],
      "additionalProperties": true
    }
  }
}
