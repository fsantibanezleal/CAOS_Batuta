{
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "implementer",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook.py",
              "report-check"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
