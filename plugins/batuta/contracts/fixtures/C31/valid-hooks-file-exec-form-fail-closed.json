{
  "description": "Batuta hooks",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook.py",
              "automation-guard"
            ],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook.py",
              "approval-capture"
            ],
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
