{
  "_why": "interpreter flags come before the launcher",
  "_expect": "exactly one argument",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook.py",
              "-I",
              "report-check"
            ]
          }
        ]
      }
    ]
  }
}
