{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook.py",
              "secrets-guard"
            ],
            "timeout": 5,
            "if": "Bash(git *)",
            "shell": "bash",
            "onFailure": "block",
            "async": false,
            "statusMessage": "scanning",
            "once": false
          }
        ]
      }
    ]
  }
}
