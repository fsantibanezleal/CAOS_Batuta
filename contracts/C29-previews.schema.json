{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_id": "C29",
  "contract_version": "1.0",
  "title": "Preview deployments",
  "description": "Which commit and which providers each preview environment serves.",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "1.0"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "required": [
    "contract_version",
    "entries"
  ],
  "additionalProperties": true,
  "$defs": {
    "entry": {
      "type": "object",
      "properties": {
        "env": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "providers": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "env",
        "url",
        "commit",
        "providers",
        "date"
      ],
      "additionalProperties": true
    }
  }
}
