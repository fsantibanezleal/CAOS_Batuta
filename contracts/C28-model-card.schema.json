{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_id": "C28",
  "contract_version": "1.0",
  "title": "Model card",
  "description": "I/O contract, version, status, baseline that satisfies the I/O contract, and metrics of a model.",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "io_contract": {
      "type": "string",
      "pattern": "^[^/\\\\:][^\\\\:]*$",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "baseline",
        "training",
        "candidate",
        "ready",
        "retired"
      ]
    },
    "baseline": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "rule",
            "constant",
            "heuristic",
            "previous-version"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "description"
      ],
      "additionalProperties": true
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "data_card": {
      "type": "string"
    },
    "training_run": {
      "type": "string"
    }
  },
  "required": [
    "contract_version",
    "id",
    "version",
    "io_contract",
    "status",
    "baseline"
  ],
  "additionalProperties": true
}
