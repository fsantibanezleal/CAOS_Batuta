{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_id": "C03",
  "contract_version": "1.0",
  "title": "Delegation report",
  "description": "A report: required sections, one D section per deliverable, the Completeness table, and the final BRIEF and REPORT lines.",
  "type": "object",
  "$defs": {
    "completeness_row": {
      "type": "object",
      "properties": {
        "ID": {
          "type": "string",
          "pattern": "^D\\d+$"
        },
        "Status": {
          "type": "string",
          "enum": [
            "DONE",
            "PARTIAL",
            "BLOCKED"
          ]
        },
        "Evidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "ID",
        "Status",
        "Evidence"
      ],
      "additionalProperties": true
    }
  }
}
