{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_id": "C02",
  "contract_version": "1.0",
  "title": "Delegation brief",
  "description": "Front matter of a brief (the machine part) plus the required sections in order.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+-\\d{4}-\\d{2}-\\d{2}(-\\d+)?$"
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "lookup",
        "run",
        "implement",
        "test",
        "docs",
        "review",
        "adversary",
        "research"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "effort": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "write_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "budget_turns": {
      "type": "integer",
      "minimum": 1
    },
    "report": {
      "type": "string",
      "minLength": 1
    },
    "serves": {
      "type": "string"
    },
    "depends": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(C\\d{2}|[a-z0-9-]+-\\d{4}-\\d{2}-\\d{2}(-\\d+)?)$"
      }
    },
    "boundary": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "id",
    "agent",
    "kind",
    "model",
    "cwd",
    "write_scope",
    "budget_turns",
    "report"
  ],
  "additionalProperties": true
}
