{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_id": "C10",
  "contract_version": "1.0",
  "title": "Feature status",
  "description": "Status front matter of a feature: phase, per-gate state, waivers, blocked.",
  "type": "object",
  "properties": {
    "feature": {
      "type": "string",
      "pattern": "^\\d{3}-[a-z0-9-]+$"
    },
    "phase": {
      "type": "string",
      "enum": [
        "P0-research",
        "P1-spec",
        "P1b-contracts",
        "P2-freeze",
        "P3-red",
        "P4-green",
        "P5-verify",
        "P6-promote",
        "done"
      ]
    },
    "gates": {
      "type": "object",
      "properties": {
        "P0-research": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "failed",
            "waived"
          ]
        },
        "P1-spec": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "failed",
            "waived"
          ]
        },
        "P1b-contracts": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "failed",
            "waived"
          ]
        },
        "P2-freeze": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "failed",
            "waived"
          ]
        },
        "P3-red": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "failed",
            "waived"
          ]
        },
        "P4-green": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "failed",
            "waived"
          ]
        },
        "P5-verify": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "failed",
            "waived"
          ]
        },
        "P6-promote": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "failed",
            "waived"
          ]
        }
      },
      "additionalProperties": false
    },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "gate": {
            "type": "string",
            "enum": [
              "P0-research",
              "P1-spec",
              "P1b-contracts",
              "P2-freeze",
              "P3-red",
              "P4-green",
              "P5-verify",
              "P6-promote"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "by": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "gate",
          "reason",
          "by",
          "date"
        ],
        "additionalProperties": true
      }
    },
    "blocked": {
      "type": "boolean"
    },
    "blocked_reason": {
      "type": "string"
    }
  },
  "required": [
    "feature",
    "phase",
    "gates"
  ],
  "additionalProperties": true
}
