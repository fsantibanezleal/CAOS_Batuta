{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_id": "C11",
  "contract_version": "1.0",
  "title": "Gate thresholds",
  "description": "Ratcheting quality thresholds with an append-only history; a decrease needs a history entry and a C10 waiver of the same date.",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "1.0"
    },
    "values": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "number"
          },
          "to": {
            "type": "number"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "date",
          "name",
          "from",
          "to",
          "reason"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "contract_version",
    "values",
    "history"
  ],
  "additionalProperties": true
}
